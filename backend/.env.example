# CircuitForge Backend Environment Variables

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=circuitforge

# CORS origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000"]

# App settings
APP_NAME=CircuitForge
DEBUG=true

# LLM Configuration (MegaLLM - OpenAI-compatible API)
OPENAI_API_KEY=your-megallm-api-key-here
OPENAI_BASE_URL=https://api.megallm.io/v1/chat/completions
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Axiom Logging Configuration (https://axiom.co - free tier: 1TB/month)
# Sign up at https://app.axiom.co/register to get your credentials
AXIOM_TOKEN=
AXIOM_ORG_ID=
AXIOM_DATASET=circuitforge-logs

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO