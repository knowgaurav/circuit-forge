# CircuitForge Backend Environment Variables
# Copy to .env for local development. In production (Render), set these in the
# service dashboard under "Environment" instead of committing them.

# --- MongoDB ---
# Local: mongodb://localhost:27017
# Production: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/circuitforge
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=circuitforge

# --- CORS (JSON array of allowed origins) ---
# Local: ["http://localhost:3000"]
# Production: ["https://your-app.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]

# --- App settings ---
APP_NAME=CircuitForge
DEBUG=true
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- LLM Configuration (OpenAI-compatible API) ---
OPENAI_API_KEY=your-llm-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# --- Google Vertex AI (Gemini) — optional ---
# Authenticated via Application Default Credentials (ADC). Leave empty to use
# the project resolved by ADC, or set it explicitly.
GOOGLE_CLOUD_PROJECT=

# --- Axiom Logging (https://axiom.co - free tier: 1TB/month) — optional ---
# Sign up at https://app.axiom.co/register and create a token at
# https://app.axiom.co/settings/tokens
AXIOM_TOKEN=
AXIOM_ORG_ID=
AXIOM_DATASET=circuitforge-logs

# --- Optional overrides (defaults shown) ---
# SESSION_EXPIRY_HOURS=24
# SESSION_CODE_LENGTH=6
# RATE_LIMIT_ACTIONS_PER_MINUTE=100
