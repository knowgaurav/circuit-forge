# CircuitForge Frontend Environment Variables
# Copy to .env for local development. In production (Vercel), set these in the
# project dashboard under "Settings → Environment Variables".
#
# NOTE: All NEXT_PUBLIC_* values are baked into the client bundle at build time
# and are publicly visible. Never put server secrets here.

# --- Backend API URL (include the /api suffix, no trailing slash) ---
# Local: http://localhost:8000/api
# Production: https://circuitforge-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- WebSocket URL for real-time collaboration ---
# Local: ws://localhost:8000/api/ws
# Production: wss://circuitforge-api.onrender.com/api/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/ws

# --- Axiom Logging (https://axiom.co) — optional ---
# Use the same dataset as the backend for easy trace correlation.
# Get a token at https://app.axiom.co/settings/tokens
NEXT_PUBLIC_AXIOM_TOKEN=
NEXT_PUBLIC_AXIOM_DATASET=circuitforge-logs
